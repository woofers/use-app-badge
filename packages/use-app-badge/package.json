{
  "name": "use-app-badge",
  "version": "0.2.0",
  "description": "Navigator Badge API wrapper for React",
  "sideEffects": false,
  "main": "./lib/cjs/index.production.js",
  "module": "./lib/es/index.production.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./lib/index.d.ts",
        "import": "./lib/es/index.development.mjs",
        "default": "./lib/cjs/index.development.js"
      },
      "production": {
        "types": "./lib/index.d.ts",
        "import": "./lib/es/index.production.mjs",
        "default": "./lib/cjs/index.production.js"
      }
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "repository": {
    "url": "git+https://github.com/woofers/use-app-badge.git"
  },
  "keywords": [
    "notification",
    "badge",
    "navigator",
    "react",
    "reactjs",
    "cross-browser",
    "push",
    "dot",
    "standardized"
  ],
  "author": "Jaxson Van Doorn <jaxson.vandoorn@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/woofers/use-app-badge/issues"
  },
  "homepage": "https://jaxs.onl/use-app-badge/",
  "scripts": {
    "start": "serve out",
    "build": "./restore.sh && bunchee -m && ./build.sh",
    "build-ci": "bunchee -m && ./build.sh",
    "package": "pnpm publish --no-git-checks --access public",
    "dev": "bunchee --watch -m",
    "test": "pnpm typecheck",
    "lint": "biome lint",
    "typecheck": "tsc --p .",
    "clean": "rimraf lib"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "standardized-app-badge": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "bunchee": "^5.1.2",
    "react": "19.0.0-rc-9598c41a20-20240603",
    "react-dom": "19.0.0-rc-9598c41a20-20240603",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}